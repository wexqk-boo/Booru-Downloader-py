# Board credentials. Copy this file to .env and fill in your values.
# It is read from the project root (or pass another path via --env-file).
# Keys are optional: without them rule34 and gelbooru stay rate limited
# (rule34 rejects unsigned searches outright with "Missing authentication").

# Rule34 — API key and user id: https://rule34.xxx/index.php?page=account&s=options
RULE34_API_KEY=
RULE34_USER_ID=

# Gelbooru — API key and user id: https://gelbooru.com/index.php?page=account&s=options
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# The other boards work without keys; credentials only raise the rate limits:
# KONACHAN_API_KEY=
# KONACHAN_LOGIN=
# YANDERE_API_KEY=
# YANDERE_LOGIN=

# Proxy, if the boards are unreachable directly.
# Example: http://127.0.0.1:10809 or socks5://127.0.0.1:10808
# PROXY_URL=
